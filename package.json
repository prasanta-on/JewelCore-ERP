{
  "name": "jewelcore-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter \"@jewelcore/*\" run build",
    "typecheck": "pnpm --filter \"@jewelcore/*\" run typecheck",
    "test": "vitest run",
    "format": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
